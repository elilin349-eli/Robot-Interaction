# iFlytek 配置
IFLY_APP_ID=YOUR_APP_ID_HERE
IFLY_API_KEY=YOUR_API_KEY_HERE
IFLY_API_SECRET=YOUR_API_SECRET_HERE

# 识别方言设置
# 可选值说明：
#   mandarin      - 普通话（默认）
#   shanghainese  - 上海话（讯飞的正确代码是 shanghainese，不是 shanghai！）
#   lmz           - 西南方言（重庆/四川）
IFLY_ACCENT=shanghainese

# 置信度阈值(0-1,越小越容易识别)
IFLY_CONF_THRESHOLD=0.12
ROBOT_PORT=COM12
