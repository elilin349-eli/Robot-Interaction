# iFlytek API Configuration
IFLY_APP_ID=YOUR_APP_ID_HERE
IFLY_API_KEY=YOUR_API_KEY_HERE
IFLY_API_SECRET=YOUR_API_SECRET_HERE

# 项目根路径
VOICE_ROBOT_ROOT=/path/to/your/Voice-Robot
MIC_DEVICE_ID=0

# 方言设置：mandarin(普通话), shanghai(上海话), shanghainese(上海话), lmz(重庆/四川)
IFLY_ACCENT=mandarin

# LeRobot 配置（数据采集）
LEROBOT_ENV_NAME=lerobot
LEROBOT_SCRIPT_PATH=lerobot/scripts/control_robot.py
LEROBOT_ROBOT_PATH=lerobot/so_101

# 可选：OpenAI API 用于指令分类回退（留空则禁用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# VAD 阈值（自动校准，一般无需修改）
IFLY_AUTO_RMS_THRESHOLD=2.5
IFLY_FUZZY_RATIO=0.6

# 【废弃】讯飞 API 不直接支持 IFLY_CONF_THRESHOLD，置信度过滤在本地代码层完成

# 强制发送音频（防止服务端超时）
IFLY_FORCE_SEND=0

# 唤醒词要求
IFLY_REQUIRE_WAKE=0

# 指令确认（需要二次确认才执行）
IFLY_CONFIRM_REQUIRED=0
IFLY_CONFIRM_TIMEOUT=5.0


# ==========================================
# LLM 配置（本地 Ollama / 云端 DeepSeek 双通道）
# ==========================================
ENABLE_LLM=1                                       # 1=启用 LLM 解析

# --- 本地模型设置 (默认) ---
LLM_PROVIDER=ollama                                # ollama / deepseek
LLM_BASE_URL=http://localhost:11434/v1             # Ollama 地址
LLM_MODEL=qwen2.5-coder:7b                         # 本地模型名

# --- 云端 DeepSeek 设置 (备用) ---
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE                               # DeepSeek API 密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com         # DeepSeek 官方地址
DEEPSEEK_MODEL=deepseek-chat                       # 云端模型

